{"id":5,"case1":"1- أَنَـا۠","case2":" بعدها همزة قطع <span class='c1'>مفتوحة</span> (10مواضع)","example":"ﵳ لَا شَرِيكَ لَهُۥ<span class='c6'> ۖ </span>وَبِذَٰلِكَ أُمِرۡتُ وَأَنَا۠ <span class='c1'>أَ</span>وَّلُ ٱلۡمُسۡلِمِينَ <span class='c6'>١٦٣</span> ﵲ  (الأنعام: 163)","ruwat":{"قالون":"<span class='c9'>الإثبات وصلا</span> ","ورش":"<span class='c9'>الإثبات وصلا</span> ","البزي":"الحذف وصلا ","قنبل":"الحذف وصلا ","الدوري":"الحذف وصلا ","السوسي":"الحذف وصلا ","هشام":"الحذف وصلا ","ابن ذكوان":"الحذف وصلا ","شعبة":"الحذف وصلا ","حفص":"الحذف وصلا ","خلف":"الحذف وصلا ","خلاد":"الحذف وصلا ","أبو الحارث":"الحذف وصلا ","دوري كسائي":"الحذف وصلا ","ابن وردان":"<span class='c9'>الإثبات وصلا</span> ","ابن جماز":"<span class='c9'>الإثبات وصلا</span> ","رويس":"الحذف وصلا ","روح":"الحذف وصلا ","إسحق":"الحذف وصلا ","إدريس":"الحذف وصلا "},"note":"","exception":""},
{"id":6,"case1":"1- أَنَـا۠","case2":" بعدها همزة قطع <span class='c1'>مضمومة</span> (موضعين)","example":"ﵳإِذۡ قَالَ إِبۡرَٰهِـۧمُ رَبِّيَ ٱلَّذِي يُـحۡيِۦ وَيُمِيتُ قَالَ أَنَا۠<span class='c1'> أُ</span>حۡيِۦ وَأُمِيتُﵲ ( البقرة: 258)","ruwat":{"قالون":"<span class='c9'>الإثبات وصلا</span> ","ورش":"<span class='c9'>الإثبات وصلا</span> ","البزي":"الحذف وصلا ","قنبل":"الحذف وصلا ","الدوري":"الحذف وصلا ","السوسي":"الحذف وصلا ","هشام":"الحذف وصلا ","ابن ذكوان":"الحذف وصلا ","شعبة":"الحذف وصلا ","حفص":"الحذف وصلا ","خلف":"الحذف وصلا ","خلاد":"الحذف وصلا ","أبو الحارث":"الحذف وصلا ","دوري كسائي":"الحذف وصلا ","ابن وردان":"<span class='c9'>الإثبات وصلا</span> ","ابن جماز":"<span class='c9'>الإثبات وصلا</span> ","رويس":"الحذف وصلا ","روح":"الحذف وصلا ","إسحق":"الحذف وصلا ","إدريس":"الحذف وصلا "},"note":"","exception":""},
