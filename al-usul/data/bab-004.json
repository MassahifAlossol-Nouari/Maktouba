{"id":11,"case1":"ملاحظات واستثناءات","case2":"","example":"","ruwat":{"قالون":"_","ورش":"_","البزي":"_","قنبل":"_","الدوري":"_","السوسي":"_","هشام":"_","ابن ذكوان":"_","شعبة":"_","حفص":"_","خلف":"_","خلاد":"_","أبو الحارث":"_","دوري كسائي":"_","ابن وردان":"_","ابن جماز":"_","رويس":" ويستثني للإمام رُويس ضم <span class='c16'>ٱلهاء </span><span class='c17'>منفردا </span>(وصلا ووفقا) فيما زالت منه ٱلياء <span class='c1'>لعارض بناء </span>أو <span class='c1'>جزم </span>في 3 مواضع وهي: ﵳوَيُلْهِ<span class='c1'>هُمُ</span> ٱلْأَمَلُﵲ (الحجر3) + ﵳيُغْنِ<span class='c1'>هُمُ</span> ٱللَّهُﵲ  (النور 32) + ﵳوَقِ<span class='c1'>هُمُ</span> ٱلسَّيِّئَاتِﵲ ( غافر 9).","روح":"_","إسحق":"_","إدريس":"_"},"note":"","exception":""},
{"id":12,"case1":"ملاحظات واستثناءات","case2":"","example":"","ruwat":{"قالون":"_","ورش":"_","البزي":"_","قنبل":"_","الدوري":"_","السوسي":"_","هشام":"_","ابن ذكوان":"_","شعبة":"_","حفص":"_","خلف":"_","خلاد":"_","أبو الحارث":"_","دوري كسائي":"_","ابن وردان":"_","ابن جماز":"_","رويس":"*الإمام رُويس يضم <span class='c16'>ٱلهاء </span><span class='c17'>منفردا </span>إذا كان قبل الهاء ياء محذوفة لبناء الأمر أو جزم المضارع في 12 موضعا وهي: ﵳ فَـَٔاتِ<span class='c17'>هُ</span>مۡ عَذَابٗا ﵲ  (الأعراف 38 ) ﵳ وَإِن يَأۡتِـ<span class='c17'>هُ</span>مۡ عَرَضٞ ﵲ (الأعراف 169 ) ﵳ لَمۡ تَأۡتِ<span class='c17'>هُ</span>م بِـَٔايَةٖﵲ (الأعراف 203 ) ﵳوَيُخۡزِ<span class='c17'>هُ</span>مۡ وَيَنۡصُرۡكُمۡﵲ (التوبة 14 ) ﵳأَلَمۡ يَأۡتِ<span class='c17'>هُ</span>مۡ نَبَأُﵲ (التوبة70 ) ﵳوَلَمَّا يَأۡتِ<span class='c17'>هُ</span>مۡ تَأۡوِيلُهُ ﵲ (يونس 39 ) ﵳأَوَلَمۡ تَأۡتِ<span class='c17'>هُ</span>م بَيِّنَةُ ﵲ (طه133 ) ﵳأَوَلَمۡ يَكۡفِ<span class='c17'>هُ</span>مۡ أَنَّا ﵲ (العنكبوت 51) ﵳءَاتِ<span class='c17'>هُ</span>مۡ ضِعۡفَيۡنِ ﵲ (الاحزاب 68) ﵳفَٱسۡتَفۡتِ<span class='c17'>هُ</span>مۡ أَهُمۡ + فَٱسۡتَفۡتِ<span class='c17'>هُ</span>مۡ أَلِرَبِّكَ ﵲ (الصافات 149,11) ﵳوَقِ<span class='c17'>هُ</span>مۡ عَذَابَ ﵲ (غافر 7) . باستثناء: ﵳوَمَن يُوَلِّهِمۡ يَوۡمَئِذٍ ﵲ ( الأنفال 16) فلا خلاف عنده بكسر الهاء.","روح":"_","إسحق":"_","إدريس":"_"},"note":"","exception":""},
