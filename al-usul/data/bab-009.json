{"id":2,"case1":"مع المفتوحة","case2":"ءَأَنْذَرْتَهُمْ (الْبَقَرَةِ6) +ءَأَلِدُ  (هُودٍ72)","example":"","ruwat":{"قالون":"1- التسهيل مع الفصل بألف","ورش":"1- الإبدال  ألفاً مع الإشباع  قبل الساكن ومع القصر قبل المتحرك +2 - التسهيل","البزي":"1- التسهيل","قنبل":"1- التسهيل","الدوري":"1- التسهيل مع الفصل بألف","السوسي":"1- التسهيل مع الفصل بألف","هشام":"1- التسهيل مع الفصل بألف + 2- التحقيق مع الفصل بألف","ابن ذكوان":"1- التحقيق","شعبة":"1- التحقيق","حفص":"1- التحقيق","خلف":"1- التحقيق","خلاد":"1- التحقيق","أبو الحارث":"1- التحقيق","دوري كسائي":"1- التحقيق","ابن وردان":"1- التسهيل مع الفصل بألف","ابن جماز":"1- التسهيل مع الفصل بألف","رويس":"1- التسهيل","روح":"1- التحقيق","إسحق":"1- التحقيق","إدريس":"1- التحقيق"},"note":"باب ءَآلذَّكَرَيۡنِ:  لكل القراء الإبدال والتسهيل لهمزة الوصل ويضيف الإمامين أبو عمرو وأبو جعفر: ءَآلسِّحۡرُۖ في سورة يونس 81 بنفس الحكم,","exception":""},
{"id":3,"case1":"مع المكسورة ","case2":"أَئِنَّكُمۡ (الْأَنْعَامِ 19) + أَئِنَّ لَنَا  (الشُّعَرَاءِ 41) ","example":"","ruwat":{"قالون":"1- التسهيل مع الفصل بألف","ورش":"1- التسهيل","البزي":"1- التسهيل","قنبل":"1- التسهيل","الدوري":"1- التسهيل مع الفصل بألف","السوسي":"1- التسهيل مع الفصل بألف","هشام":"1- التحقيق مع الفصل بألف + 2- التحقيق","ابن ذكوان":"1- التحقيق","شعبة":"1- التحقيق","حفص":"1- التحقيق","خلف":"1- التحقيق","خلاد":"1- التحقيق","أبو الحارث":"1- التحقيق","دوري كسائي":"1- التحقيق","ابن وردان":"1- التسهيل مع الفصل بألف","ابن جماز":"1- التسهيل مع الفصل بألف","رويس":"1- التسهيل","روح":"1- التحقيق","إسحق":"1- التحقيق","إدريس":"1- التحقيق"},"note":"في حالة دخول هَمْزَة الِاسْتِفْهَام على هَمْزَةُ الْوَصْل في الأفعال  كل القراء لهم حذف همزة الوصل (أَتَّخَذۡتُمۡ -أَطَّلَعَ -أَفۡتَرَىٰ - أَصۡطَفَى -أَسۡتَكۡبَرۡتَ -أَسۡتَغۡفَرۡتَ ).  لكن في موضع ص 63 : (ٱتَّخَذۡنَٰهُمۡ سِخۡرِيًّا ) يقرأ كل من أبو عمرو + حمزة + الكسائي + يعقوب + خلف العاشر  بدون استفهام مع الابتداء بالكسر, ويقرأ الباقون على الأصل.","exception":""},
{"id":4,"case1":"مع المضمومة","case2":"أَؤُنَبِّئُكُمْ  (الِ عِمْرَانَ 15) + أَءُنزِلَ  (ص8)","example":"","ruwat":{"قالون":"1- التسهيل مع الفصل بألف","ورش":"1- التسهيل","البزي":"1- التسهيل","قنبل":"1- التسهيل","الدوري":"1- التسهيل مع الفصل بألف  + 2- التسهيل","السوسي":"1- التسهيل + 2- التسهيل مع الفصل بألف","هشام":"1- التحقيق مع الفصل بألف + 2- التحقيق","ابن ذكوان":"1- التحقيق","شعبة":"1- التحقيق","حفص":"1- التحقيق","خلف":"1- التحقيق","خلاد":"1- التحقيق","أبو الحارث":"1- التحقيق","دوري كسائي":"1- التحقيق","ابن وردان":"1- التسهيل مع الفصل بألف","ابن جماز":"1- التسهيل مع الفصل بألف","رويس":"1- التسهيل","روح":"1- التحقيق","إسحق":"1- التحقيق","إدريس":"1- التحقيق"},"note":"لفظ أَئِمَّةَ:  تحقيق الهمزتين :(ابن عامر + عاصم +  حمزة + الكسائي + روح + خلف العاشر ) - تحقيق الهمزتين مع الفصل بألف:  (هشام: وجه2) - تسهيل الثانية  مع الفصل بألف: ( أبو جعفر) -تسهيل الثانية :( نافع +  ابن كثير + أبو عمرو +  رويس)","exception":""},
